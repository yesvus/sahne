{
  "name": "sahne",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent-operated, narration-first video production with reusable assets",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts SahneDemo out/sahne-demo.mp4",
    "render:example": "remotion render src/index.ts SahneDemo out/sahne-demo.mp4 --props=./examples/demo.json",
    "render:smoke": "remotion render src/index.ts SahneDemo out/smoke.mp4 --props=./examples/demo.json --frames=0-29 --codec=h264 --concurrency=2 --log=warn",
    "verify:smoke": "node scripts/verify-render.mjs out/smoke.mp4",
    "compositions": "remotion compositions src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "render:timeline": "remotion render src/index.ts SahneTimeline out/timeline-demo.mp4 --props=./examples/two-scenes.json",
    "render:timeline:smoke": "remotion render src/index.ts SahneTimeline out/timeline-smoke.mp4 --props=./examples/two-scenes.json --frames=60-89 --codec=h264 --concurrency=2 --log=warn",
    "assets:validate": "tsx scripts/asset-catalog.ts validate",
    "assets:search": "tsx scripts/asset-catalog.ts search",
    "storyboard:validate": "tsx scripts/validate-storyboard.ts",
    "template:variables": "tsx scripts/template-variables.ts",
    "audio:mix": "tsx scripts/mix-audio.ts"
  },
  "dependencies": {
    "remotion": "4.0.540",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.540",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
